pid LR 
  %% ── Equipment ─────────────────────────────────────────────────────────── 
  CV: block "Central heating" = ${states['binary_sensor.boiler_burner']}
  icon CV mdi:heat-pump-outline 86 

  P-1: pump "VV pump keuken" = ${states['switch.keuken_cv_pomp_vv_lsc_plug_relay']}
  VV-Keuken: block "Vloerverwarming" 
  icon VV-Keuken mdi:heating-coil 48 
  P-2: pump "VV pump studio" = ${states['switch.studio_cv_pomp_vv_lsc_plug_relay']}
  VV-Studio: block "Vloerverwarming"
  icon VV-Studio mdi:heating-coil 48 
  T-1: tee
  T-2: tee

  %% ── connections ───────────────────────────────────────────────────────────
  CV --> T-1 --> P-1 --> VV-Keuken
  VV-Keuken --> T-2
  T-2 --> CV
  T-1 --> P-2 --> VV-Studio
  VV-Studio --> T-2 

  %% ── The drawing's colours ───────────────────────────────────────────────
  classDef blue fill:#7da7d9,stroke:#4a78b5
  classDef orange fill:#ff8a1f,stroke:#e06c00
  linkStyle default stroke:#5b8fd0
  linkStyle 0,1,2,5,6 stroke:#ef6c00

  %% ── Live line colours (in the card): a circuit goes grey while its pump is off, ──
  %% ── and the main flow turns red while the burner fires. These come after the     ──
  %% ── fixed colours above, so they win; outside Home Assistant those stay.         ──
  linkStyle 1,2 stroke:${if(is_state('switch.keuken_cv_pomp_vv_lsc_plug_relay', 'on'), '#ef6c00', '#9e9e9e')}
  linkStyle 3 stroke:${if(is_state('switch.keuken_cv_pomp_vv_lsc_plug_relay', 'on'), '#5b8fd0', '#9e9e9e')}
  linkStyle 5,6 stroke:${if(is_state('switch.studio_cv_pomp_vv_lsc_plug_relay', 'on'), '#ef6c00', '#9e9e9e')}
  linkStyle 7 stroke:${if(is_state('switch.studio_cv_pomp_vv_lsc_plug_relay', 'on'), '#5b8fd0', '#9e9e9e')}
  linkStyle 0 stroke:${if(is_state('binary_sensor.boiler_burner', 'on'), '#c62828', '#ef6c00')}
